# Pinned official Mumble server for the macOS smoke test (scripts/smoke/fetch-mac-server.sh).
# Mumble 1.6.1001 (1.6.x RC 2) is the first release with macOS server builds; switch to the final
# 1.6 release once it is out. The hashes are those of the release assets; each asset is also
# checked against its .sig, made with the key in mumble-auto-build-2026.asc (from
# https://github.com/mumble-voip/mumble-gpg-signatures). Bump all lines together.
MAC_SERVER_VERSION=1.6.1001
MAC_SERVER_TAG=v1.6.0-alpha2
MAC_SERVER_KEY_FPR=F62408DEFB8603FBF45B02244FDC47DD5D6A6D14
MAC_SERVER_SHA256_arm64=4ebe0fc165d9014cd063ca5f503e78cf110039eae9c5cc15fb9b1d909ccd5b45
MAC_SERVER_SHA256_x64=9d2e0573609e286fc15fb0e01a9b61e43294d1a6b3839093deeef787e5db7043
