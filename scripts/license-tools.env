# Pinned versions of the licence and SBOM tools. scripts/generate-notices.sh and
# scripts/generate-sbom.sh read this file; the workflows install the cargo tools at these versions
# (.github/actions/cargo-tool) and cache them. Notices generated with another cargo-about version
# can differ, so local runs warn about a mismatch.
CARGO_ABOUT_VERSION=0.9.2
CARGO_CYCLONEDX_VERSION=0.5.9
LICENSE_CHECKER_VERSION=5.0.1
CYCLONEDX_NPM_VERSION=6.0.1
