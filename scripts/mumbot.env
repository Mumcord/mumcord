# Pinned release of the test bot (https://github.com/Mumcord/mumbot), used by the E2E and smoke
# tests. scripts/fetch-mumbot.sh downloads the tester archive (mumbot-tester-<version>-<target>,
# the test bot is not in the main archives) and checks these hashes (from the release's
# SHA256SUMS). Bump all lines together. The library tag in crates/engine/Cargo.toml for the live
# engine tests is bumped separately.
MUMBOT_VERSION=0.4.1
MUMBOT_SHA256_linux_x86_64=07f06e4a30843cf87f09142a45081f320d9c6e90770f9a0a9aa180ddfb00c28d
MUMBOT_SHA256_linux_aarch64=d7238d48477292c18995f07b84b93861404df650ee00003d878dd8c3c3648d71
MUMBOT_SHA256_windows_x86_64=3dfd367787fd479d85995a6844bbb435d4f9a2371f7125f3fea9ae9c142277a2
MUMBOT_SHA256_macos_universal=2bebf016e202f2821ba26371eb396849d200b5db52bcea829d9cb2b3d02d30b9
