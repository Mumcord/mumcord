# Pinned release of the test bot (https://github.com/Mumcord/mumbot), used by the E2E and smoke
# tests. scripts/fetch-mumbot.sh downloads the tester archive (mumbot-tester-<version>-<target>,
# the test bot is not in the main archives) and checks these hashes (from the release's
# SHA256SUMS). Bump all lines together. The library tag in crates/engine/Cargo.toml for the live
# engine tests is bumped separately.
MUMBOT_VERSION=0.2.0
MUMBOT_SHA256_linux_x86_64=01feb3b8d9bfe0dd69c1d7244ffc059b6bc1ad1b692496b5c320beca22b06769
MUMBOT_SHA256_linux_aarch64=40e0b22a0788275d117a08d64d272d696b1814a135307d5b63c7a5e22450e6a1
MUMBOT_SHA256_windows_x86_64=a58f9f1f6b1979b8100198bb0cf6bf12d32f53478cd5c9158eae4e895dedb046
MUMBOT_SHA256_macos_universal=9dea5dcc22bdc40fbb03a70224ac92c94680091b218183be346d1f88152c5cfb
