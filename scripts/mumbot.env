# Pinned release of the test bot (https://github.com/Mumcord/mumbot), used by the E2E and smoke
# tests. scripts/fetch-mumbot.sh downloads the tester archive (mumbot-tester-<version>-<target>,
# the test bot is not in the main archives) and checks these hashes (from the release's
# SHA256SUMS). Bump all lines together. The library tag in crates/engine/Cargo.toml for the live
# engine tests is bumped separately.
MUMBOT_VERSION=0.6.0
MUMBOT_SHA256_linux_x86_64=b8d8be4c4dd1fd6692f3334c421190ca6a4c9c266264b65a2deeaf7ea3038389
MUMBOT_SHA256_linux_aarch64=852ac59b0a6f3ec3c4d3caae68d7ea0ae6c1ed783ea3a0246d00830bc7dc4021
MUMBOT_SHA256_windows_x86_64=981c07d601fed5dcfcddbb1a8b017894fa89424498d652e7337c120933e7484c
MUMBOT_SHA256_macos_universal=1f07d7b6401f75908eff76d10fcfa45333fc694206224541cb75b2b45f8bd9a5
