# Pinned release of the test bot (https://github.com/Mumcord/mumbot), used by the E2E and smoke
# tests. scripts/fetch-mumbot.sh downloads the tester archive (mumbot-tester-<version>-<target>,
# the test bot is not in the main archives) and checks these hashes (from the release's
# SHA256SUMS). Bump all lines together. The library tag in crates/engine/Cargo.toml for the live
# engine tests is bumped separately.
MUMBOT_VERSION=0.3.0
MUMBOT_SHA256_linux_x86_64=2a294cbe3105e82d00a59a4ded77ce8e9bbe5bdf4deb1fdca8ba6422c1c619df
MUMBOT_SHA256_linux_aarch64=a501a9603a19863696555a6640ea8536c1f4eab16e1a09b5653a42fd82d1c354
MUMBOT_SHA256_windows_x86_64=9963fa8ab6bb7faf282289cc415111d0933f57c0d5a74b672cd88f51fc73a731
MUMBOT_SHA256_macos_universal=419b148c039045cfe58dd075003e99c21172322fa7c38a57e1285c2df35dce68
