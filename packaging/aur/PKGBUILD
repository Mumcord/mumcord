# Maintainer: Tobias Vorwachs <tobias@vorwachs.com>
#
# Repackages the official Mumcord release .deb. The checksums below are placeholders; the
# release workflow (.github/workflows/aur.yml) fills them from the release's SHA256SUMS.
pkgname=mumcord-bin
_name=Mumcord
pkgver=0.0.0
pkgrel=1
pkgdesc='Modern voice chat client compatible with Mumble (prebuilt release)'
arch=('x86_64' 'aarch64')
url='https://github.com/Mumcord/mumcord'
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'alsa-lib' 'libpipewire' 'hicolor-icon-theme'
         'gst-plugins-good' 'gst-plugins-bad' 'gst-libav')
optdepends=('pipewire-alsa: audio through PipeWire'
            'pulseaudio-alsa: audio through PulseAudio')
provides=('mumcord')
conflicts=('mumcord')
options=('!debug')
_base="$url/releases/download/v$pkgver"
source_x86_64=("$_base/${_name}_${pkgver}_amd64.deb")
source_aarch64=("$_base/${_name}_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/Mumcord/mumcord/v$pkgver/LICENSE")
sha256sums=('SKIP')

package() {
  # makepkg does not unpack .deb files itself; the payload is data.tar.* inside the ar archive.
  bsdtar -xf "$srcdir/${_name}_${pkgver}_"*.deb -C "$srcdir" 'data.tar.*'
  bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"
  chmod -R go-w "$pkgdir"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
