/// Secrets in the OS keychain (FR-6.25). Needs the `secrets` permission (official plugins only).
///
/// Reference-only: a secret is written only by the user through a `password` component, and a
/// plugin can never read it back. It can only name it in a `net.http` header (see `http`).
/// Names are 1–128 bytes, e.g. `bot/<server>/<peer-key>`. Without an available keychain every
/// call returns `not-permitted`; there is no plaintext fallback.
interface secrets {
  use types.{error};

  /// Whether a secret with this name has been stored. Errors: `not-permitted`, `invalid`,
  /// `too-large`.
  exists: func(name: string) -> result<bool, error>;

  /// Deletes a secret; deleting a missing one is not an error. Errors as `exists`.
  delete: func(name: string) -> result<_, error>;
}
