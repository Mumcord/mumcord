interface ui {
use types.{error, session};
variant slot {
panel,
member-badge(session),
profile-card(session),
chat-card(string),
chat-decoration(session),
settings,
dialog,
}
type node-index = u32;
enum animation {
bob,
hop,
wave,
nap,
sparkle,
shake,
fade,
}
enum direction {
row,
column,
}
enum align {
start,
center,
end,
stretch,
}
enum justify {
start,
end,
space-between,
fill-first,
}
record stack {
direction: direction,
gap: u8,
align: align,
justify: option<justify>,
}
enum text-style {
body,
caption,
heading,
monospace,
}
record text {
text: string,
style: text-style,
color: option<string>,
}
record image {
asset: string,
alt: string,
width: u16,
height: u16,
}
record sprite {
asset: string,
alt: string,
frame-width: u16,
frame-height: u16,
frames: u8,
fps: u8,
still-frame: u8,
}
record meter {
label: string,
value: f32,
color: option<string>,
}
enum tone {
neutral,
success,
warning,
danger,
accent,
}
enum button-kind {
primary,
secondary,
danger,
}
record button {
label: string,
action: string,
kind: button-kind,
disabled: bool,
expanded: option<bool>,
detail: option<string>,
}
record icon-button {
icon: string,
label: string,
action: string,
disabled: bool,
}
record copy-button {
label: string,
text: string,
kind: button-kind,
}
record chip {
text: string,
color: option<string>,
tone: option<tone>,
}
record progress {
label: string,
value: option<f32>,
}
record list-props {
label: string,
reorder-action: option<string>,
}
record toggle {
label: string,
value: bool,
action: string,
disabled: bool,
}
record select-option {
value: string,
label: string,
}
record select {
label: string,
options: list<select-option>,
selected: option<string>,
action: string,
refresh-action: option<string>,
disabled: bool,
}
record slider {
label: string,
min: f32,
max: f32,
step: f32,
value: f32,
action: string,
disabled: bool,
}
enum input-purpose {
plain,
server-address,
}
record text-input {
label: string,
value: string,
placeholder: string,
max-bytes: u8,
purpose: input-purpose,
action: string,
disabled: bool,
help: option<string>,
help-tone: option<tone>,
error: option<string>,
}
record password {
label: string,
secret: string,
action: string,
disabled: bool,
help: option<string>,
help-tone: option<tone>,
error: option<string>,
}
record file-picker {
label: string,
accept: list<string>,
action: string,
disabled: bool,
}
record countdown {
label: string,
until: u64,
}
variant component {
stack(stack),
text(text),
image(image),
sprite(sprite),
meter(meter),
button(button),
icon-button(icon-button),
chip(chip),
divider,
progress(progress),
%list(list-props),
toggle(toggle),
select(select),
slider(slider),
text-input(text-input),
password(password),
file-picker(file-picker),
countdown(countdown),
copy-button(copy-button),
}
record node {
component: component,
animation: option<animation>,
children: list<node-index>,
}
set-tree: func(slot: slot, nodes: list<node>) -> result<_, error>;
clear: func(slot: slot);
open-dialog: func(title: string) -> result<_, error>;
open-dialog-with: func(title: string, subtitle: option<string>) -> result<_, error>;
close-dialog: func();
set-user-menu-entry: func(label: option<string>) -> result<_, error>;
record user-menu-filter {
bot-name: option<string>,
bot-module: option<string>,
sessions: list<session>,
}
set-user-menu-entry-for: func(label: string, filter: user-menu-filter) -> result<_, error>;
open-panel-popover: func() -> result<_, error>;
close-panel-popover: func();
open-permissions: func() -> result<_, error>;
}
