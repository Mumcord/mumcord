== events.wit
interface events {
use types.{peer};
use theme.{theme-info};
use timers.{timer-id};
use ui.{slot};
use http.{request-id, http-response, http-error, file-handle};
record channel {
id: u32,
name: string,
}
record self-state {
me: option<peer>,
server: option<string>,
channel: option<channel>,
muted: bool,
deafened: bool,
do-not-disturb: bool,
}
enum visibility {
everyone,
friends,
nobody,
}
record plugin-settings {
granted: list<string>,
visibility: visibility,
}
enum panel-visibility {
hidden,
inline,
expanded,
}
variant action-value {
none,
boolean(bool),
number(f32),
text(string),
reorder(tuple<u32, u32>),
file(file-handle),
}
variant action-source {
slot(slot),
command,
}
record ui-action {
source: action-source,
action: string,
value: action-value,
}
record peer-message {
sender: peer,
kind: u8,
payload: list<u8>,
direct: bool,
}
record chat-trigger {
sender: peer,
trigger: string,
args: string,
}
record chat-match {
sender: peer,
pattern-index: u8,
text: string,
}
record http-result {
id: request-id,
outcome: result<http-response, http-error>,
}
variant event {
talking(tuple<peer, bool>),
joined(peer),
left(peer),
screen-share-started(peer),
chat-activity(tuple<peer, channel>),
mentioned(peer),
self-changed(self-state),
theme-changed(theme-info),
language-changed(string),
settings-changed(plugin-settings),
ui-action(ui-action),
timer(timer-id),
peer-message(peer-message),
profile-card-opened(peer),
panel-visibility-changed(panel-visibility),
user-menu-requested(peer),
dialog-closed,
http-response(http-result),
webview-message(string),
chat-trigger(chat-trigger),
chat-match(chat-match),
peer-ready(peer),
}
}
== http.wit
interface http {
use types.{error};
type request-id = u32;
enum method {
get,
post,
put,
patch,
delete,
}
variant header-value {
text(string),
secret(string),
}
record header {
name: string,
value: header-value,
}
type file-handle = u64;
variant form-value {
text(string),
file(file-handle),
}
record form-field {
name: string,
value: form-value,
}
variant body {
empty,
bytes(list<u8>),
file(file-handle),
form(list<form-field>),
}
record http-request {
method: method,
url: string,
headers: list<header>,
body: body,
}
record http-response {
status: u16,
headers: list<tuple<string, string>>,
body: list<u8>,
}
variant http-error {
host-not-allowed,
invalid-request,
redirect,
timeout,
tls(string),
connect(string),
response-too-large,
}
request: func(req: http-request) -> result<request-id, error>;
}
