{
  "manifest": 1,
  "id": "test-growth",
  "name": "Fixture growth",
  "description": "E2E test plugin, version 1.1.0: adds ui.webview and peers.relay, so it scores High risk (update hold, after).",
  "version": "1.1.0",
  "api": "^1.1",
  "authors": ["Mumcord test fixtures"],
  "license": "MIT",
  "categories": ["tools"],
  "icon": "assets/icon.svg",
  "permissions": {
    "required": [
      "ui.panel",
      "net.origins",
      "chat.send",
      "events.voice",
      "peers.messages",
      "ui.webview",
      "peers.relay"
    ]
  },
  "net": {
    "origins": [
      {
        "origin": "https://fixture-a.example",
        "purpose": "origin_0"
      }
    ]
  },
  "webview": {
    "places": ["panel"]
  }
}
