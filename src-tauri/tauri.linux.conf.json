      "deb": {
        "files": {
          "/usr/lib/mumcord/libmumcord_overlay_layer.so": "gen/overlay-layer/libmumcord_overlay_layer.so"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/mumcord/libmumcord_overlay_layer.so": "gen/overlay-layer/libmumcord_overlay_layer.so"
        }
      }
    }
  }
}
