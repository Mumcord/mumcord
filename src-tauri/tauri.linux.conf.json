{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run build:overlay-layer && npm run dev",
    "beforeBuildCommand": "npm run build:overlay-layer && npm run build"
  },
  "bundle": {
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib/mumcord/libmumcord_overlay_layer.so": "gen/overlay-layer/libmumcord_overlay_layer.so"
        }
      },
      "deb": {
        "depends": [
          "libasound2 | libasound2t64",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "files": {
          "/usr/lib/mumcord/libmumcord_overlay_layer.so": "gen/overlay-layer/libmumcord_overlay_layer.so"
        }
      },
      "rpm": {
        "depends": ["pipewire-libs", "gstreamer1-plugins-good", "gstreamer1-plugins-bad-free"],
        "recommends": ["gstreamer1-libav"],
        "desktopTemplate": "linux/mumcord.desktop",
        "files": {
          "/usr/lib/mumcord/libmumcord_overlay_layer.so": "gen/overlay-layer/libmumcord_overlay_layer.so"
        }
      }
    }
  }
}
