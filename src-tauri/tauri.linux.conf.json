  "build": {
    "beforeDevCommand": "npm run build:overlay-layer && npm run dev",
    "beforeBuildCommand": "npm run build:overlay-layer && npm run build"
  },
  "bundle": {
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/mumcord/libmumcord_overlay_layer.so": "gen/overlay-layer/libmumcord_overlay_layer.so"
        }
