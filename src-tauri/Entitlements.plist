<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime blocks microphone access unless this is declared. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Camera sharing (spec 08): the hardened runtime blocks the camera unless this is declared,
       without any prompt or error. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- Positional audio loads Mumble game plugins (third-party .dylib files) with dlopen; the
       hardened runtime's library validation would refuse every library not signed by us. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Plugins run as WebAssembly that wasmtime compiles to machine code at run time (and loads
       from its compile cache). The hardened runtime kills the app with "Code Signature Invalid"
       when it executes such pages unless unsigned executable memory is allowed. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
