<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Mumcord needs the microphone so other people on the server can hear you.</string>
  <!-- Camera sharing (spec 08, FR-8.25): shown in the system prompt on first camera use;
       without the key macOS ends the app as soon as it asks for the camera. -->
  <key>NSCameraUsageDescription</key>
  <string>Mumcord uses your camera only when you turn it on, to show you to people in your voice channel.</string>
  <!-- Since macOS 15, connections to local network addresses fail with "No route to host"
       unless this permission is granted; without the key the prompt never appears. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Mumcord connects to Mumble servers and other Mumcord users on your local network.</string>
</dict>
</plist>
