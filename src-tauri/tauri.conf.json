{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mumcord",
  "identifier": "app.mumcord.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mumcord",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; frame-src http://localhost:* https://open.spotify.com/embed/ https://w.soundcloud.com/player/"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "app", "dmg"],
    "publisher": "Mumcord contributors",
    "copyright": "Copyright (c) 2026 Tobias Vorwachs and Mumcord contributors. AGPL-3.0-only.",
    "license": "AGPL-3.0-only",
    "category": "SocialNetworking",
    "shortDescription": "Voice chat client compatible with Mumble",
    "longDescription": "Mumcord is a modern voice chat client compatible with Mumble. It is not affiliated with the Mumble project.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/mumcord.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "quiet"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["mumble"]
      }
    }
  }
}
