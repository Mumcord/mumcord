{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window's own web view (not the plugin frame web views inside it)",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "deep-link:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "dialog:default"
  ]
}
